# Murmuration environment variables
# Copy to .env and fill in actual values

# Frontend — set VITE_API_URL to the deployed API Gateway URL after `sam deploy`
VITE_API_URL=http://localhost:8000

# Backend — set by SAM automatically in Lambda; for local dev, use the table name
HOUSEHOLDS_TABLE=murmuration-households-dev

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AWS region for local development with real DynamoDB
AWS_DEFAULT_REGION=ap-south-1
